# 基础运行配置
# JSON 日志级别，例如 DEBUG、INFO、WARNING 或 ERROR。
LOG_LEVEL=INFO
# SQLite 数据库文件路径，生产环境建议使用受保护的绝对路径。
DATABASE_PATH=./data/agent-relay.db
# 默认工作区路径，必须是已存在的目录。
DEFAULT_WORKSPACE=/absolute/path/to/project
# 允许访问的工作区根目录，多个绝对路径使用英文逗号分隔。
WORKSPACE_ROOTS=/absolute/path/to/allowed/root

# Telegram 接入配置
# 是否启用 Telegram long polling，可选值为 true 或 false。
TELEGRAM_ENABLED=false
# BotFather 签发的机器人令牌，仅在启用 Telegram 时必填。
TELEGRAM_BOT_TOKEN=
# 允许访问的 chat id，多个值使用英文逗号分隔。
TELEGRAM_ALLOWED_CHAT_IDS=
# 允许访问的 user id，多个值使用英文逗号分隔；chat id 与 user id 必须同时命中白名单。
TELEGRAM_ALLOWED_USER_IDS=
# 自由文本处理模式，可选值为 auto、ask 或 run。
TELEGRAM_FREE_TEXT_MODE=auto
# Telegram Mini App 的公开 HTTPS /app 地址，留空表示不注册工作台菜单按钮。
TELEGRAM_WEBAPP_URL=

# HTTP/SSE API 配置
# 是否启用 /v1 业务 API 和 /docs，可选值为 true 或 false；健康检查仍会保留。
API_ENABLED=false
# API 监听地址，生产环境建议保持为 loopback，避免直接暴露到公网。
API_HOST=127.0.0.1
# API 监听端口，取值范围为 1-65535。
API_PORT=8787
# 业务 API Bearer Token，应使用至少 32 个字符的随机密钥。
API_BEARER_TOKEN=
# Bearer Token 固定映射的服务端主体标识，客户端请求无法覆盖。
API_ACTOR_ID=api

# Agent CLI 配置
# Codex CLI 命令名或绝对路径；服务部署建议使用通过 doctor 校验的稳定绝对路径。
CODEX_EXECUTABLE=/absolute/path/to/codex
# Codex 推理强度，具体可用值由当前 Codex CLI 和模型决定。
CODEX_REASONING_EFFORT=high
# Claude Code CLI 命令名或绝对路径；服务部署建议使用通过 doctor 校验的稳定绝对路径。
CLAUDE_EXECUTABLE=/absolute/path/to/claude
# Claude 默认使用固定模型 ID，避免 sonnet/opus 等滚动别名改变实际型号。
CLAUDE_MODEL=claude-sonnet-5
# Claude 执行阶段允许使用的工具，多个工具名使用英文逗号分隔。
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write,NotebookEdit,Bash
